# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=YOUR_JUNKEY_SECRET

# ─── App ──────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL=YOUR_FRONT_END
NODE_ENV=production
