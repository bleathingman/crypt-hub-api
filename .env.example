# ─── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=toto
DB_USER=toto_user
DB_PASS=PASSWORD_SQL

# ─── Discord OAuth ────────────────────────────────────────────
DISCORD_CLIENT_ID=1234567890123456
DISCORD_CLIENT_SECRET=YOUR_DISCORD_SECRET
